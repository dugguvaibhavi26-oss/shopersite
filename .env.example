# App Config
NEXT_PUBLIC_APP_NAME="shopersite"
NEXT_PUBLIC_APP_DOMAIN="shopersite.in"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# Dev OTP Guard (CRITICAL: When NODE_ENV=production, ALLOW_DEV_MOCK_OTP=true will crash startup)
ALLOW_DEV_MOCK_OTP="true"
DEV_MOCK_OTP="123456"

# Database (PostgreSQL with non-superuser app role for RLS)
DATABASE_URL="postgres://shopper_app_user:shopper_password@localhost:5432/shopper_db"

# SMS Provider (e.g. MSG91, Console Mock)
SMS_PROVIDER="mock"
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_DLT_TE_ID=""

# WhatsApp Business API
WHATSAPP_PROVIDER="mock"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Cloudflare R2 / Storage
STORAGE_PROVIDER="mock"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Razorpay (Platform's own subscriptions)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Google sign-in inside the Android/iOS app (public OAuth client IDs, not secrets).
# Web application client of the Firebase project (Firebase console > Authentication > Google > Web SDK configuration)
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# iOS OAuth client (needed for Google sign-in in the iOS app only)
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=""

# Store addresses. Leave "false" until shopersite.in AND *.shopersite.in point at this Vercel project.
# While false, store links use the working address <app>/s/<store>. When "true", every store link
# becomes https://<store>.<NEXT_PUBLIC_APP_DOMAIN>.
NEXT_PUBLIC_STORE_SUBDOMAINS_LIVE="false"

# ---------------------------------------------------------------------------------------------
# Cashfree (every seller gets their OWN Cashfree merchant account; see CASHFREE_SETUP.md)
# Server-only. NEVER prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------------------------
# "sandbox" for testing, "production" once Cashfree has approved your partner account
CASHFREE_ENV="sandbox"
# Partner Dashboard > Developers > API Keys (sandbox and production keys are different)
CASHFREE_PARTNER_API_KEY=""
# Optional overrides (defaults shown)
# CASHFREE_PARTNER_API_VERSION="2023-01-01"
# CASHFREE_PG_API_VERSION="2025-01-01"

# Firebase service account for the payment server routes (Firebase console > Project settings >
# Service accounts > Generate new private key). Paste the whole JSON on one line, or its base64.
FIREBASE_SERVICE_ACCOUNT=""

# Who can open /admin (verified emails, comma separated). The database rules use the same list:
# run `npm run rules:deploy` after changing it.
NEXT_PUBLIC_ADMIN_EMAILS="tejaswithreddy0101@gmail.com"
