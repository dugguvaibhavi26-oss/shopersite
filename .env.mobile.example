# Copy to .env.mobile (git-ignored) to change where the Android/iOS app loads the site from.
# These are build settings for the native shell only. No secrets belong here.

# Production site the app opens (must be https). Change this when shopersite.in goes live.
CAP_SERVER_URL=https://shopersite-app.vercel.app

# Dev server for `--dev` builds. Leave empty to use this computer's LAN IP automatically.
# Android emulator: http://10.0.2.2:3000   iOS simulator: http://localhost:3000
CAP_DEV_SERVER_URL=
