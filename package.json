{
  "name": "shopper.site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "mobile:assets": "capacitor-assets generate --android --ios --assetPath mobile/assets --iconBackgroundColor \"#000000\" --iconBackgroundColorDark \"#000000\" --splashBackgroundColor \"#ffffff\" --splashBackgroundColorDark \"#ffffff\"",
    "mobile:dev-server": "node scripts/mobile.mjs dev-server",
    "cap:sync": "node scripts/mobile.mjs sync",
    "cap:sync:dev": "node scripts/mobile.mjs sync --dev",
    "android:open": "node scripts/mobile.mjs open android",
    "android:run": "node scripts/mobile.mjs run android",
    "android:run:dev": "node scripts/mobile.mjs run android --dev",
    "android:apk:debug": "node scripts/mobile.mjs gradle assembleDebug",
    "android:apk:release": "node scripts/mobile.mjs gradle assembleRelease",
    "android:aab": "node scripts/mobile.mjs gradle bundleRelease",
    "ios:open": "node scripts/mobile.mjs open ios",
    "ios:run": "node scripts/mobile.mjs run ios",
    "ios:run:dev": "node scripts/mobile.mjs run ios --dev",
    "test:rules": "npx -y firebase-tools@13.35.1 emulators:exec --only firestore,storage,auth --project demo-shopersite \"node tests/rules/rules.test.mjs\"",
    "rules:deploy": "node scripts/deploy-rules.mjs --deploy",
    "data:migrate": "node scripts/migrate-private.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "^8.7.5",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.16.0",
    "next": "^16.4.2",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@electric-sql/pglite": "^0.5.11",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "drizzle-kit": "^0.31.4",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
